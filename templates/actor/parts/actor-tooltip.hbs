<section class="content">
  <section class="header">
    <div class="top">
      <img src="{{img}}" alt="{{name}}">
      <div class="name name-stacked"><span class="title">{{name}}</span><span class="subtitle">T.E.A.R.S.</span></div>
    </div>
  </section>
  <ul class="pills">
    <li class="pill pill-sm"><span class="label">LE: {{health.value}} / {{health.max}}</span></li>
    <li class="pill pill-sm"><span class="label">GG: {{mentalHealth.value}} / {{mentalHealth.max}}</span></li>
    <li class="pill pill-sm"><span class="label">Rüstung: {{armor.value}}</span></li>
  </ul>
  <ul class="pills">
    <li class="pill pill-sm"><span class="label">KK {{attributes.kk}}</span></li>
    <li class="pill pill-sm"><span class="label">AU {{attributes.au}}</span></li>
    <li class="pill pill-sm"><span class="label">GE {{attributes.ge}}</span></li>
    <li class="pill pill-sm"><span class="label">IN {{attributes.in}}</span></li>
    <li class="pill pill-sm"><span class="label">CH {{attributes.ch}}</span></li>
    <li class="pill pill-sm"><span class="label">MB {{attributes.mb}}</span></li>
  </ul>
</section>
